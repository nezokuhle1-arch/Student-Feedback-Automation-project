    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst errors = [];\n\nconst required = [\"studentName\", \"email\", \"courseName\", \"rating\", \"message\"];\nfor (const field of required) {\n  if (body[field] === undefined || body[field] === null || String(body[field]).trim() === \"\") {\n    errors.push(`${field} is required`);\n  }\n}\n\nconst email = String(body.email || \"\").trim();\nif (email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n  errors.push(\"email is not valid\");\n}\n\nconst rating = Number(body.rating);\nif (body.rating !== undefined && body.rating !== \"\" &&\n    (!Number.isInteger(rating) || rating < 1 || rating > 5)) {\n  errors.push(\"rating must be a whole number from 1 to 5\");\n}\n\nreturn [{\n  json: {\n    isValid: errors.length === 0,\n    errors,\n    data: {\n      studentName: String(body.studentName || \"\").trim(),\n      email,\n      courseName: String(body.courseName || \"\").trim(),\n      rating,\n      message: String(body.message || \"\").trim(),\n    },\n  },\n}];"
      },
